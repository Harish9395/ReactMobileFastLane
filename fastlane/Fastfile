default_platform(:android)

platform :android do

  desc "Build APK"
  lane :build_apk do

    gradle(
      task: "clean"
    )

    gradle(
      task: "assembleRelease",
      flags: "-Pci=true"
    )

    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]

    UI.success("========================================")
    UI.success("APK BUILD SUCCESSFUL")
    UI.success("APK: #{apk_path}")
    UI.success("========================================")

    unless File.exist?(apk_path)
      UI.user_error!("APK does not exist: #{apk_path}")
    end

    apk_path
  end


  desc "Build APK and upload to Sauce Labs"
  lane :upload_to_saucelabs do

    # ----------------------------------------
    # 1. Build APK
    # ----------------------------------------

    gradle(
      task: "clean"
    )

    gradle(
      task: "assembleRelease",
      flags: "-Pci=true"
    )

    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]

    unless apk_path && File.exist?(apk_path)
      UI.user_error!("APK was not created: #{apk_path}")
    end

    UI.success("APK built successfully")
    UI.message("APK: #{apk_path}")


    # ----------------------------------------
    # 2. Sauce configuration
    # ----------------------------------------

    sauce_username = ENV["SAUCE_USERNAME"]
    sauce_access_key = ENV["SAUCE_ACCESS_KEY"]

    unless sauce_username && !sauce_username.empty?
      UI.user_error!("SAUCE_USERNAME is not set")
    end

    unless sauce_access_key && !sauce_access_key.empty?
      UI.user_error!("SAUCE_ACCESS_KEY is not set")
    end

    sauce_region = ENV.fetch("SAUCE_REGION", "eu-central-1")

    sauce_api =
      case sauce_region
      when "eu-central-1"
        "https://api.eu-central-1.saucelabs.com"
      when "us-west-1"
        "https://api.us-west-1.saucelabs.com"
      when "us-east-4"
        "https://api.us-east-4.saucelabs.com"
      else
        UI.user_error!("Unsupported Sauce region: #{sauce_region}")
      end


    # ----------------------------------------
    # 3. Upload APK
    # ----------------------------------------

    UI.message("========================================")
    UI.message("Uploading APK to Sauce Labs")
    UI.message("========================================")

    app_name = "myapp-#{Time.now.to_i}.apk"

    response_file = "/tmp/sauce_upload_response.json"

    sh(
      "curl",
      "--fail-with-body",
      "--show-error",
      "--silent",
      "--location",
      "-u",
      "#{sauce_username}:#{sauce_access_key}",
      "--request",
      "POST",
      "#{sauce_api}/v1/storage/upload",
      "--form",
      "payload=@#{apk_path}",
      "--form",
      "name=#{app_name}",
      "--form",
      "description=GitHub Actions Android build",
      "--form",
      "tags=github-actions,android",
      "--output",
      response_file
    )


    # ----------------------------------------
    # 4. Parse Sauce response
    # ----------------------------------------

    response = JSON.parse(File.read(response_file))

    UI.message("========================================")
    UI.message("Sauce Labs response")
    UI.message("========================================")

    UI.message(JSON.pretty_generate(response))


    # IMPORTANT:
    # Sauce response is:
    #
    # {
    #   "item": {
    #     "id": "xxxxx"
    #   }
    # }
    #
    # NOT:
    #
    # {
    #   "file_id": "xxxxx"
    # }

    file_id = response.dig("item", "id")

    unless file_id
      UI.user_error!(
        "Could not find Sauce Storage file ID in response:\n#{JSON.pretty_generate(response)}"
      )
    end


    # ----------------------------------------
    # 5. Save Sauce information
    # ----------------------------------------

    File.write("sauce_app_id.txt", file_id)
    File.write("sauce_app.txt", "storage:#{file_id}")

    UI.success("========================================")
    UI.success("SAUCE UPLOAD SUCCESSFUL")
    UI.success("File ID: #{file_id}")
    UI.success("App reference: storage:#{file_id}")
    UI.success("File name: #{app_name}")
    UI.success("========================================")

    file_id
  end
end
