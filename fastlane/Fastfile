default_platform(:android)

platform :android do
  desc "Build release APK and upload to Sauce Labs"

  lane :upload_to_saucelabs do
    android_dir = File.expand_path("..", __dir__)

    apk_path = File.join(
      android_dir,
      "app",
      "build",
      "outputs",
      "apk",
      "release",
      "app-release.apk"
    )

    gradlew_path = File.join(android_dir, "gradlew")

    UI.message("Android project: #{android_dir}")
    UI.message("Gradle wrapper: #{gradlew_path}")
    UI.message("APK path: #{apk_path}")

    # Check Gradle wrapper
    unless File.exist?(gradlew_path)
      UI.user_error!("gradlew not found at #{gradlew_path}")
    end

    # Build APK
    gradle(
      project_dir: android_dir,
      task: "clean"
    )

    gradle(
      project_dir: android_dir,
      task: "assembleRelease",
      flags: "-Pci=true"
    )

    # Check APK
    unless File.exist?(apk_path)
      UI.user_error!("APK was not created: #{apk_path}")
    end

    apk_size = File.size(apk_path)

    UI.success("APK built successfully")
    UI.message("APK: #{apk_path}")
    UI.message("APK size: #{apk_size} bytes")

    # Check Sauce Labs credentials
    sauce_username = ENV["SAUCE_USERNAME"]
    sauce_access_key = ENV["SAUCE_ACCESS_KEY"]

    if sauce_username.to_s.empty? || sauce_access_key.to_s.empty?
      UI.user_error!(
        "SAUCE_USERNAME and SAUCE_ACCESS_KEY must be configured"
      )
    end

    UI.message("Uploading APK to Sauce Labs...")

    # Upload APK to Sauce Labs Storage
    sh(
      "curl",
      "--fail-with-body",
      "--location",
      "--user", "#{sauce_username}:#{sauce_access_key}",
      "--request", "POST",
      "https://api.eu-central-1.saucelabs.com/v1/storage/upload",
      "--form", "payload=@#{apk_path}",
      "--form", "name=myapp.apk"
    )

    UI.success("APK uploaded successfully to Sauce Labs as myapp.apk")
  end

  desc "Build release APK"

  lane :apk do
    android_dir = File.expand_path("..", __dir__)

    gradle(
      project_dir: android_dir,
      task: "clean"
    )

    gradle(
      project_dir: android_dir,
      task: "assembleRelease",
      flags: "-Pci=true"
    )

    UI.success("Release APK built successfully")
  end
end
