default_platform(:android)

platform :android do
  desc "Build release APK and upload to Sauce Labs"

  lane :upload_to_saucelabs do
    android_dir = File.expand_path("../..", __dir__)

    gradlew_path = File.join(android_dir, "gradlew")

    apk_path = File.join(
      android_dir,
      "app",
      "build",
      "outputs",
      "apk",
      "release",
      "app-release.apk"
    )

    UI.message("Fastfile directory: #{__dir__}")
    UI.message("Android project: #{android_dir}")
    UI.message("Gradle wrapper: #{gradlew_path}")
    UI.message("APK path: #{apk_path}")

    unless File.exist?(gradlew_path)
      UI.user_error!(
        "gradlew not found at #{gradlew_path}"
      )
    end

    gradle(
      project_dir: android_dir,
      task: "clean"
    )

    gradle(
      project_dir: android_dir,
      task: "assembleRelease",
      flags: "-Pci=true"
    )

    unless File.exist?(apk_path)
      UI.user_error!("APK was not created: #{apk_path}")
    end

    UI.success("APK built successfully: #{apk_path}")

    unless ENV["SAUCE_USERNAME"] && ENV["SAUCE_ACCESS_KEY"]
      UI.user_error!(
        "SAUCE_USERNAME and SAUCE_ACCESS_KEY must be configured"
      )
    end

    sh(
      "curl",
      "-f",
      "-u",
      "#{ENV['SAUCE_USERNAME']}:#{ENV['SAUCE_ACCESS_KEY']}",
      "-X",
      "POST",
      "https://api.eu-central-1.saucelabs.com/v1/storage/upload?overwrite=true",
      "-F",
      "file=@#{apk_path}",
      "-F",
      "name=myapp.apk"
    )

    UI.success("APK uploaded to Sauce Labs")
  end

  desc "Build release APK"

  lane :apk do
    android_dir = File.expand_path("../..", __dir__)

    gradle(
      project_dir: android_dir,
      task: "clean"
    )

    gradle(
      project_dir: android_dir,
      task: "assembleRelease",
      flags: "-Pci=true"
    )
  end
end
